---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Equipo Directorio — Fundación Compasyon" description="Equipo Directorio — Fundación Compasyon / Fundafil - Pas" activeNav="nosotros">
<main>

    <!-- ═══════════════════════════════════════════════════
         HERO: EQUIPO DIRECTORIO
    ════════════════════════════════════════════════════ -->
    <section class="page-hero" style="background-image: linear-gradient(180deg, rgba(20, 20, 20, 0) 30%, rgba(20, 20, 20, 0.92) 100%), url('/assets/team_directorio.png');" aria-label="Portada Equipo Directorio">
      <div class="container">
        <div class="page-hero__content" data-reveal>
          <h1 class="page-hero__title">Equipo Directorio</h1>
          <p class="page-hero__subtitle">
            Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in. Varius fermentum non egestas leo massa mi habitant interdum ac.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         NUESTRO EQUIPO (4 MIEMBROS: 2x2)
    ════════════════════════════════════════════════════ -->
