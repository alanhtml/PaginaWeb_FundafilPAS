---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto — Fundación Compasyon" description="Contacto — Comunícate con Fundación Compasyon / Fundafil - Pas en El Alto y La Paz, Bolivia." activeNav="contacto">
<main class="contact-page">

    <div class="container">

      <div class="contact-hero" data-reveal>
        <h1 class="projects-hero__title">Contáctanos</h1>
        <p class="projects-hero__subtitle">
          Nuestro equipo está listo para responder tus consultas, coordinar visitas o brindarte información detallada sobre nuestros proyectos.
        </p>
      </div>

      <!-- ═══════════════════════════════════════════════════
           LAYOUT PRINCIPAL DE CONTACTO (FIGMA SPEC)
      ════════════════════════════════════════════════════ -->
      <div class="contact-layout">

        <!-- Formulario -->
        <div class="volunteer-form" data-reveal data-reveal-delay="1">
          <h2 style="color: var(--navy); font-size: 1.5rem; margin-bottom: 4px;">Envíanos un mensaje</h2>
          <p style="color: var(--text-mid); font-size: 0.875rem; margin-bottom: 16px;">
            Te responderemos en un plazo de 24 - 48 horas
          </p>

          <form onsubmit="event.preventDefault(); alert('¡Mensaje enviado con éxito! Te responderemos muy pronto.'); this.reset();">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
              <div class="form-group">
                <label for="contact-name">Nombres *</label>
                <input type="text" id="contact-name" class="form-input" placeholder="Tus nombres" required>
              </div>
              <div class="form-group">
                <label for="contact-lastname">Apellidos *</label>
                <input type="text" id="contact-lastname" class="form-input" placeholder="Tus apellidos" required>
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
              <label for="contact-email">Correo Electrónico *</label>
              <input type="email" id="contact-email" class="form-input" placeholder="ejemplo@correo.com" required>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
              <label for="contact-message">Escribe el mensaje *</label>
              <textarea id="contact-message" class="form-textarea" placeholder="¿En qué te podemos ayudar?" required></textarea>
            </div>

            <button type="submit" class="btn btn--primary" style="width: 100%; justify-content: center; padding: 16px;">
              Enviar mensaje
            </button>
          </form>
        </div>

        <!-- Casa Matriz Info -->
        <div class="contact-info-card" data-reveal data-reveal-delay="2">
          <h3>Casa Matriz</h3>
          
          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.1 2 5 5.1 5 9C5 14.2 12 22 12 22C12 22 19 14.2 19 9C19 5.1 15.9 2 12 2ZM12 11.5C10.6 11.5 9.5 10.4 9.5 9C9.5 7.6 10.6 6.5 12 6.5C13.4 6.5 14.5 7.6 14.5 9C14.5 10.4 13.4 11.5 12 11.5Z"/></svg>
            <div>
              <strong>Dirección Principal:</strong>
              <p>Calle N-1 #20, Zona Oro Negro, Ciudad El Alto, La Paz, Bolivia</p>
            </div>
          </div>

          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8C8 13.6 10.4 16 13.2 17.4L15.4 15.2C15.7 14.9 16.1 14.8 16.4 15C17.4 15.4 18.5 15.6 19.6 15.6C20.4 15.6 21 16.2 21 17V20C21 20.8 20.4 21.4 19.6 21.4C10.2 21.4 2.6 13.8 2.6 4.4C2.6 3.6 3.2 3 4 3H7C7.8 3 8.4 3.6 8.4 4.4C8.4 5.5 8.6 6.6 9 7.6C9.2 7.9 9.1 8.3 8.8 8.6L6.6 10.8Z"/></svg>
            <div>
              <strong>Teléfono / WhatsApp:</strong>
              <p>+591 79560383 (De lunes a viernes | 8:00 a. m. a 5:00 p. m.)</p>
            </div>
          </div>

          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"/></svg>
            <div>
              <strong>Correo Oficial:</strong>
              <p>info@fundafilpas.org.bo</p>
            </div>
          </div>

          <a href="https://maps.google.com" target="_blank" rel="noopener" class="btn btn--outline-white" style="margin-top: auto; justify-content: center;">
            Ver en mapa
          </a>
        </div>

      </div>

      <!-- ═══════════════════════════════════════════════════
           NUESTRAS SEDES (FIGMA SPEC)
      ════════════════════════════════════════════════════ -->
      <section style="margin-bottom: 90px;">
        <div style="text-align: center; max-width: 600px; margin: 0 auto 36px;" data-reveal>
          <h2 class="section-title">Nuestras Sedes</h2>
          <p style="color: var(--text-mid); font-size: 0.95rem; margin-top: 8px;">
            También puedes visitarnos en cualquiera de nuestras sedes comunitarias
          </p>
        </div>

        <div class="sedes-grid">
          <!-- Sede 1: Cumaravi -->
          <div class="sede-card" data-reveal data-reveal-delay="1">
            <span class="tag">Zona Norte</span>
            <h4>Sede Cumaravi</h4>
            <p style="color: var(--text-mid); font-size: 0.875rem;">Centro de atención integral, apoyo escolar y comedor infantil.</p>
            <div style="font-size: 0.8125rem; color: var(--text-dark);">
              <p><strong>Número de Contacto:</strong> +591 79560383</p>
              <p><strong>Correo Electrónico:</strong> cumaravi@fundafilpas.org.bo</p>
            </div>
            <a href="https://maps.google.com" target="_blank" rel="noopener" class="btn btn--outline btn--sm" style="margin-top: 8px; align-self: flex-start;">Ver ubicación</a>
          </div>

          <!-- Sede 2: Kantutas -->
          <div class="sede-card" data-reveal data-reveal-delay="2">
            <span class="tag">Zona Norte</span>
            <h4>Sede Kantutas</h4>
            <p style="color: var(--text-mid); font-size: 0.875rem;">Centro de juventud, talleres vocacionales y formación tecnológica.</p>
            <div style="font-size: 0.8125rem; color: var(--text-dark);">
              <p><strong>Número de Contacto:</strong> +591 79560383</p>
              <p><strong>Correo Electrónico:</strong> kantutas@fundafilpas.org.bo</p>
            </div>
            <a href="https://maps.google.com" target="_blank" rel="noopener" class="btn btn--outline btn--sm" style="margin-top: 8px; align-self: flex-start;">Ver ubicación</a>
          </div>

          <!-- Sede 3: Oro Negro -->
          <div class="sede-card" data-reveal data-reveal-delay="3">
            <span class="tag">Oficina Central</span>
            <h4>Sede Oro Negro</h4>
            <p style="color: var(--text-mid); font-size: 0.875rem;">Administración general, voluntariado y recepción de donaciones.</p>
            <div style="font-size: 0.8125rem; color: var(--text-dark);">
              <p><strong>Número de Contacto:</strong> +591 79560383</p>
              <p><strong>Correo Electrónico:</strong> oronegro@fundafilpas.org.bo</p>
            </div>
            <a href="https://maps.google.com" target="_blank" rel="noopener" class="btn btn--outline btn--sm" style="margin-top: 8px; align-self: flex-start;">Ver ubicación</a>
          </div>
        </div>
      </section>

    </div>

  </main>
</Layout>
