---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Programa de Niñez — Fundación Compasyon" description="Programa de Niñez — Fundación Compasyon / Fundafil - Pas" activeNav="programas">
<main>

    <!-- ═══════════════════════════════════════════════════
         HERO: PROGRAMA DE NIÑEZ
    ════════════════════════════════════════════════════ -->
    <section class="program-hero" style="background-image: linear-gradient(180deg, rgba(20, 20, 20, 0) 30%, rgba(20, 20, 20, 0.9) 100%), url('/assets/ninez.png');" aria-label="Portada Programa de Niñez">
      <div class="container">
        <div class="program-hero__content" data-reveal>
          <h1 class="program-hero__title">Programa de Niñez</h1>
          <p class="program-hero__desc">
            Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in. Varius fermentum non egestas leo massa mi habitant interdum ac.
          </p>
          <a href="/como-apoyar" class="btn btn--gold">Apoyar programa</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         NUESTRO OBJETIVO
    ════════════════════════════════════════════════════ -->
    <section class="objective-section" aria-label="Nuestro Objetivo">
      <div class="container">
        <h2 class="section-title" data-reveal>Nuestro Objetivo</h2>
        <div class="objective-box" data-reveal data-reveal-delay="1">
          <div class="objective-circle"></div>
          <p class="objective-text">
            Descripción del problema. Lorem ipsum dolor sit amet consectetur. Aliquam pellentesque amet purus ornare leo. Scelerisque faucibus dui auctor ante ut. Risus congue tortor nibh pellentesque tellus nulla suscipit facilisis. Aliquet ut nulla condimentum eu gravida faucibus amet sed morbi. Rhoncus a arcu scelerisque nunc ornare.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         ¿CÓMO AYUDAMOS?
    ════════════════════════════════════════════════════ -->
    <section class="help-section" aria-label="¿Cómo ayudamos?">
      <div class="container">
        <h2 class="section-title" data-reveal>¿Cómo ayudamos?</h2>

        <div class="help-grid">
          <div class="help-card" data-reveal data-reveal-delay="1">
            <div class="help-card__circle"></div>
            <h3 class="help-card__title">Talleres y capacitaciones</h3>
            <span class="help-card__subtitle">De 12 a 22 años</span>
            <p class="help-card__text">
              Lorem ipsum dolor sit amet consectetur. Quisque commodo auctor bibendum dignissim congue.
            </p>
          </div>

          <div class="help-card" data-reveal data-reveal-delay="2">
            <div class="help-card__circle"></div>
            <h3 class="help-card__title">Salud integral</h3>
            <span class="help-card__subtitle">Atención médica de manera mensual</span>
            <p class="help-card__text">
              Lorem ipsum dolor sit amet consectetur. Quisque commodo auctor bibendum dignissim congue.
            </p>
          </div>

          <div class="help-card" data-reveal data-reveal-delay="3">
            <div class="help-card__circle"></div>
            <h3 class="help-card__title">Guía y apoyo</h3>
            <span class="help-card__subtitle">En sus dificultades y problemas</span>
            <p class="help-card__text">
              Lorem ipsum dolor sit amet consectetur. Quisque commodo auctor bibendum dignissim congue.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         IMPACTO DEL PROGRAMA
    ════════════════════════════════════════════════════ -->
    <section class="program-impact-section" aria-label="Impacto del programa">
      <div class="container">
        <h2 class="section-title" data-reveal>Impacto del programa</h2>
        <p class="program-impact__subtitle" data-reveal>Enero 2020 a 2021</p>

        <div class="program-impact__grid">
          <div class="impact-badge" data-reveal data-reveal-delay="1">
            <div class="impact-badge__circle"></div>
            <div class="impact-badge__text">
              <span class="impact-badge__number">+1200</span>
              <span class="impact-badge__label">Jóvenes participantes</span>
            </div>
          </div>

          <div class="impact-badge" data-reveal data-reveal-delay="2">
            <div class="impact-badge__circle"></div>
            <div class="impact-badge__text">
              <span class="impact-badge__number">+60 Talleres</span>
              <span class="impact-badge__label">realizados</span>
            </div>
          </div>

          <div class="impact-badge" data-reveal data-reveal-delay="3">
            <div class="impact-badge__circle"></div>
            <div class="impact-badge__text">
              <span class="impact-badge__number">+120 Líderes</span>
              <span class="impact-badge__label">formados ya servir</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         PROYECTOS RELACIONADOS
    ════════════════════════════════════════════════════ -->
    <section class="related-projects-section" aria-label="Proyectos relacionados">
      <div class="container">
        <h2 class="section-title" data-reveal>Proyectos relacionados</h2>

        <div class="related-projects-grid">
          <div class="rel-project-card" data-reveal data-reveal-delay="1">
            <div class="rel-project-card__thumb" style="background: #7B8599;"></div>
            <div class="rel-project-card__body">
              <h3 class="rel-project-card__title">Emprendimiento y Generación de ingresos</h3>
              <p class="rel-project-card__desc">
                Lorem ipsum dolor sit ametvidd consectetur. Mauris in convallis leo id dignissim.
              </p>
              <a href="/proyectos" class="rel-project-card__btn">Ver proyecto</a>
            </div>
          </div>

          <div class="rel-project-card" data-reveal data-reveal-delay="2">
            <div class="rel-project-card__thumb" style="background: #68738B;"></div>
            <div class="rel-project-card__body">
              <h3 class="rel-project-card__title">Capacitación y desarrollo de Habilidades</h3>
              <p class="rel-project-card__desc">
                Lorem ipsum dolor sit ametvidd consectetur.
              </p>
              <a href="/proyectos" class="rel-project-card__btn">Ver proyecto</a>
            </div>
          </div>

          <div class="rel-project-card" data-reveal data-reveal-delay="3">
            <div class="rel-project-card__thumb" style="background: #5E6982;"></div>
            <div class="rel-project-card__body">
              <h3 class="rel-project-card__title">Salud Integral</h3>
              <p class="rel-project-card__desc">
                Lorem ipsum dolor sit ametvidd consectetur. Mauris in convallis leo id dignissim.
              </p>
              <a href="/proyectos" class="rel-project-card__btn">Ver proyecto</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         OTROS PROGRAMAS
    ════════════════════════════════════════════════════ -->
    <section class="other-areas-section" aria-label="Otros programas">
      <div class="container">
        <h2 class="other-areas-heading" data-reveal>Otros programas</h2>

        <div class="other-areas-grid">
          <!-- Juventud -->
          <div class="other-area-card" data-reveal data-reveal-delay="1">
            <div class="other-area-card__thumb" style="background-image: url('/assets/juventud.png');"></div>
            <div class="other-area-card__body">
              <h3 class="other-area-card__title">Juventud</h3>
              <p class="other-area-card__desc">Lorem ipsum dolor sit ametvidd consectetur.</p>
              <a href="/programa-juventud" class="other-area-card__btn">Ver programa</a>
            </div>
          </div>

          <!-- 1ra Infancia -->
          <div class="other-area-card" data-reveal data-reveal-delay="2">
            <div class="other-area-card__thumb" style="background-image: url('/assets/primera_infancia.png');"></div>
            <div class="other-area-card__body">
              <h3 class="other-area-card__title">1ra Infancia</h3>
              <p class="other-area-card__desc">Lorem ipsum dolor sit ametvidd consectetur.</p>
              <a href="/programa-infancia" class="other-area-card__btn">Ver programa</a>
            </div>
          </div>

          <!-- Red Hogar -->
          <div class="other-area-card" data-reveal data-reveal-delay="3">
            <div class="other-area-card__thumb" style="background-image: url('/assets/red_hogar.png');"></div>
            <div class="other-area-card__body">
              <h3 class="other-area-card__title">Red Hogar</h3>
              <p class="other-area-card__desc">Lorem ipsum dolor sit ametvidd consectetur.</p>
              <a href="/programa-red-hogar" class="other-area-card__btn">Ver programa</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
