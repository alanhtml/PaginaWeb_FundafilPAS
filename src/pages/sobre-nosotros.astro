---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sobre Nosotros — Fundación Compasyon" description="Sobre Fundación Compasyon — Conoce nuestra historia, misión, visión y los valores que impulsan la transformación de niños y familias en Bolivia." activeNav="nosotros">
<main>

    <!-- ═══════════════════════════════════════════════════
         HERO: SOBRE NOSOTROS
    ════════════════════════════════════════════════════ -->
    <section class="page-hero page-hero--about" aria-label="Portada Sobre Nosotros">
      <div class="container">
        <div class="page-hero__content" data-reveal>
          <h1 class="page-hero__title">Comprometidos con el<br>desarrollo de niños y familias</h1>
          <p class="page-hero__subtitle">
            Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in. Varius fermentum non egestas leo massa mi habitant interdum ac.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         NUESTRA HISTORIA
    ════════════════════════════════════════════════════ -->
    <section class="history-section" id="historia" aria-label="Nuestra Historia">
      <div class="container">
        <div class="history-card" data-reveal>
          <h2 class="section-title">Nuestra Historia</h2>
          <p>
            Lorem ipsum dolor sit amet consectetur. Ac gravida id scelerisque arcu pellentesque vulputate. Nunc tellus maecenas malesuada scelerisque viverra pulvinar quam et enim. Urna laoreet eget ultrices egestas volutpat. Cras ac quis amet donec convallis non elementum. Neque quam faucibus nec sed ipsum tincidunt. Ac cursus in non dolor eget donec laoreet. Tristique diam fames ut ut velit venenatis sed elit. Interdum urna arcu nisi diam. Sed erat arcu justo porta faucibus facilisi id. Curabitur eu arcu viverra duis lectus adipiscing donec tortor nisi. Porta ultricies ipsum mauris fusce gravida. Tempus in placerat dui congue. Eget diam viverra a viverra phasellus aliquam. Lectus eu lectus vitae sem id. Sem justo lacus in gravida hac cursus. Id suspendisse pretium laoreet vel et. Phasellus et morbi nunc egestas viverra diam facilisi. Nec a non adipiscing quam sollicitudin morbi sit. Sollicitudin proin tempor metus consectetur volutpat rhoncus aenean cras.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         MISIÓN & VISIÓN
    ════════════════════════════════════════════════════ -->
    <section class="mission-vision-section" id="mision-vision" aria-label="Misión y Visión">
      <div class="mission-vision-grid">
        <div class="mv-card mv-card--mission" data-reveal data-reveal-delay="1">
          <h2 class="mv-card__title">Misión</h2>
          <p class="mv-card__text">
            Lorem ipsum dolor sit amet consectetur. Ac gravida id scelerisque arcu pellentesque vulputate. Nunc tellus maecenas malesuada scelerisque viverra pulvinar quam et enim. Urna laoreet eget ultrices egestas volutpat. Cras ac quis amet donec convallis non elementum.
          </p>
        </div>
        <div class="mv-card mv-card--vision" data-reveal data-reveal-delay="2">
          <h2 class="mv-card__title">Visión</h2>
          <p class="mv-card__text">
            Lorem ipsum dolor sit amet consectetur. Ac gravida id scelerisque arcu pellentesque vulputate. Nunc tellus maecenas malesuada scelerisque viverra pulvinar quam et enim. Urna laoreet eget ultrices egestas volutpat. Cras ac quis amet donec convallis non elementum.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         NUESTROS VALORES
    ════════════════════════════════════════════════════ -->
    <section class="values-section" id="valores" aria-label="Nuestros Valores">
      <div class="container">
        <h2 class="section-title" data-reveal>NUESTROS VALORES</h2>

        <div class="values-grid">
          <div class="value-item" data-reveal data-reveal-delay="1">
            <div class="value-circle"></div>
            <div class="value-title">Valor 1</div>
          </div>
          <div class="value-item" data-reveal data-reveal-delay="2">
            <div class="value-circle"></div>
            <div class="value-title">Valor 2</div>
          </div>
          <div class="value-item" data-reveal data-reveal-delay="3">
            <div class="value-circle"></div>
            <div class="value-title">Valor 3</div>
          </div>
          <div class="value-item" data-reveal data-reveal-delay="4">
            <div class="value-circle"></div>
            <div class="value-title">Valor 4</div>
          </div>
          <div class="value-item" data-reveal data-reveal-delay="5">
            <div class="value-circle"></div>
            <div class="value-title">Valor 5</div>
          </div>
          <div class="value-item" data-reveal data-reveal-delay="6">
            <div class="value-circle"></div>
            <div class="value-title">Valor 6</div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
