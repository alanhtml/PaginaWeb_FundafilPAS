---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nuestro Equipo — Fundación Compasyon" description="Nuestro Equipo — Conoce a los profesionales y vocacionados que hacen posible cada proyecto y programa en Fundafil - Pas." activeNav="nosotros">
<main>

    <!-- ═══════════════════════════════════════════════════
         HERO: NUESTRO EQUIPO
    ════════════════════════════════════════════════════ -->
    <section class="page-hero page-hero--team" aria-label="Portada Nuestro Equipo">
      <div class="container">
        <h1 class="page-hero__quote" data-reveal>
          &ldquo;Conoce al equipo que hace posible<br>nuestro trabajo en cada comunidad&rdquo;
        </h1>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         EQUIPO EJECUTIVO
    ════════════════════════════════════════════════════ -->
    <section class="team-page-section" id="ejecutivo" aria-label="Equipo Ejecutivo">
      <div class="container">
        <h2 class="team-section-heading" data-reveal>Equipo Ejecutivo</h2>

        <div class="team-row-two">
          <!-- Directorio -->
          <div class="team-f-card" style="background-image: url('/assets/team_directorio.png');" data-reveal data-reveal-delay="1">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Directorio</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-directorio" class="team-f-card__btn">Ver más</a>
            </div>
          </div>

          <!-- Administrativo y Programas -->
          <div class="team-f-card" style="background-image: url('/assets/team_administrativo.png');" data-reveal data-reveal-delay="2">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Administrativo y Programas</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-administrativo" class="team-f-card__btn">Ver más</a>
            </div>
          </div>
        </div>

        <div class="team-row-one">
          <!-- Patrocinio -->
          <div class="team-f-card" style="background-image: url('/assets/team_patrocinio.png');" data-reveal data-reveal-delay="3">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Patrocinio</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-administrativo" class="team-f-card__btn">Ver más</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         EQUIPO DE PROGRAMAS
    ════════════════════════════════════════════════════ -->
    <section class="team-page-section" id="programas-equipo" aria-label="Equipo de Programas">
      <div class="container">
        <h2 class="team-section-heading" data-reveal>Equipo de Programas</h2>

        <div class="team-row-two">
          <!-- Juventud -->
          <div class="team-f-card" style="background-image: url('/assets/team_juventud.png');" data-reveal data-reveal-delay="1">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Juventud</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-juventud" class="team-f-card__btn">Ver más</a>
            </div>
          </div>

          <!-- Niñez -->
          <div class="team-f-card" style="background-image: url('/assets/team_ninez.png');" data-reveal data-reveal-delay="2">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Niñez</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-ninez" class="team-f-card__btn">Ver más</a>
            </div>
          </div>
        </div>

        <div class="team-row-one">
          <!-- Base Hogar y Supervivencia -->
          <div class="team-f-card" style="background-image: url('/assets/team_base_hogar.png');" data-reveal data-reveal-delay="3">
            <div class="team-f-card__overlay">
              <h3 class="team-f-card__title">Base Hogar y Supervivencia</h3>
              <p class="team-f-card__desc">
                Lorem ipsum dolor sit amet consectetur. Risus nunc malesuada dictum netus urna in.
              </p>
              <a href="/equipo-base-hogar" class="team-f-card__btn">Ver más</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
